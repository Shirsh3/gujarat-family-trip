{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "gujarat-family-trip",
  "main": "./worker.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gujarat-trip-reviews",
      "database_id": "6903edf4-e024-4bdd-b480-132362972180",
      "migrations_dir": "./migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "031126252c5245b181003eeddd64f264",
      "secret_name": "OPENAI_API_KEY"
    }
  ]
}
